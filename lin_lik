#include <stdlib.h>
#include <stdio.h>	
typedef struct Node
{
    int data;
    struct Node* next;
}Node;

Node* insert(Node* head, int data) {
    // 1. Allocate memory for the new node
    Node* new_node = (Node*)malloc(sizeof(Node));
    new_node->data = data;
    new_node->next = NULL;

    // Case 1: If the list is empty, return the new node as head
    if (head == NULL) {
        return new_node;
    }

    // Case 2: Traverse to the last node
    Node* current = head;
    while (current->next != NULL) {
        current = current->next;
    }

    // Link the last node's next pointer to the new node
    current->next = new_node;

    // Return the original head of the list
    return head;
}
  //Complete this function


void display(Node *head)
{
	Node *start=head;
	while(start)
	{
		printf("%d ",start->data);
		start=start->next;
	}
}
int main()
{
	int T,data;
    scanf("%d",&T);
    Node *head=NULL;	
    while(T-->0){
        scanf("%d",&data);
        head=insert(head,data);
    }
  display(head);
		
}
